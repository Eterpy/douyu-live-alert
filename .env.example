# 复制为 .env 后修改：cp .env.example .env && chmod 600 .env
# 修改后执行 docker compose up -d --force-recreate 生效。

# ===== 必填：监控的直播间 =====
# 逗号分隔的真实房间号，最多 20 个。可写成“房间号=显示名称”自定义邮件里的主播名，
# 省略名称时使用斗鱼返回的主播昵称。靓号（短号）请先用 resolve-room 命令换成真实房间号。
# 示例：DOUYU_ROOMS=123456,654321=某主播
DOUYU_ROOMS=

# dry-run 只记录模拟邮件，不连接 SMTP；验收无误后改为 send。
NOTIFICATION_MODE=dry-run

# ===== 邮件：NOTIFICATION_MODE=send 或执行 test-email 时必填 =====
SMTP_HOST=
# 587 配 starttls，465 配 ssl
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# 须是邮件服务商允许的发件地址
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=斗鱼开播提醒
SMTP_TO_ADDRESS=

# ===== 通知策略 =====
NOTIFY_LIVE=true
NOTIFY_OFFLINE=true
# 只有同场开播邮件已被 SMTP 接受，才发送下播邮件
OFFLINE_REQUIRES_LIVE_EMAIL=true
# 首次启动时已经在播的场次默认静默；需要它的下播邮件时同时关闭上一项
NOTIFY_OFFLINE_FOR_BASELINE_LIVE=false
# 停机或网络故障等证据中断期间开播的场次，开播时间在此秒数内且晚于中断前最后证据时照常提醒；0 表示一律静默
STARTUP_MISSED_EVENT_WINDOW_SECONDS=900

# ===== 高级参数：一般无需修改，取值范围见 README =====
DOUYU_TRANSPORT=tcp
POLL_INTERVAL_SECONDS=30
LIVE_CONFIRM_SAMPLES=2
LIVE_CONFIRM_GAP_SECONDS=10
OFFLINE_CONFIRM_SECONDS=120
OFFLINE_CONFIRM_SAMPLES=3
OFFLINE_FINAL_EVIDENCE_MAX_AGE_SECONDS=30
OFFLINE_RESTART_GRACE_SECONDS=600
MAX_NOTIFICATION_AGE_SECONDS=900
HTTP_TIMEOUT_SECONDS=8
BACKOFF_INITIAL_SECONDS=5
BACKOFF_MAX_SECONDS=300
SMTP_TIMEOUT_SECONDS=15
SMTP_TOTAL_TIMEOUT_SECONDS=45
SMTP_PRECONNECT=true
SMTP_MAX_ATTEMPTS=4
OBSERVATION_RETENTION_DAYS=30
LOG_LEVEL=INFO
